    "camelcase": "^9.0.0",
    "glob": "^13.0.0",
    "marked": "^17.0.1",
    "tencentcloud-sdk-nodejs-tmt": "^4.1.134"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@octokit/plugin-rest-endpoint-methods": "^17.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^1.0.2",
    "lint-staged": "^16.2.7",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.16.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
