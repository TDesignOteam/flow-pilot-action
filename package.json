    "url": "https://github.com/TDesignOteam/flow-pilot-action/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint . ",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
